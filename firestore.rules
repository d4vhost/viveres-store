rules_version = '2';

// Reglas mínimas para POS Víveres.
//
// ATENCIÓN: la app no tiene inicio de sesión, así que estas reglas permiten leer
// y escribir a cualquiera que conozca la dirección de la app. Validan la forma de
// los datos, no quién los envía. Si publicas la app abiertamente, añade Firebase
// Authentication y exige `request.auth != null` en cada `allow`.
service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['id_producto', 'nombre', 'categoria', 'precio_unitario'])
        && request.resource.data.id_producto is string
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.categoria is string
        && request.resource.data.precio_unitario is number
        && request.resource.data.precio_unitario >= 0;
    }

    match /sales/{saleId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['id', 'fecha', 'items', 'total', 'efectivo', 'vuelto'])
        && request.resource.data.id == saleId
        && request.resource.data.fecha is number
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.efectivo is number
        && request.resource.data.vuelto is number;
    }
  }
}
